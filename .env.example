# Copy to ignored .env, then enter your MongoDB URI locally. Never commit credentials.
MONGODB_URI=
MONGODB_DATABASE=

# Server-owned demo identities. Set distinct opaque tokens locally.
DEMO_REVIEWER_TOKEN=
DEMO_PM_TOKEN=
DEMO_REVIEWER_USER_ID=demo-reviewer
DEMO_PM_USER_ID=demo-pm
CORS_ORIGINS=http://localhost:5173
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
# Incremental summaries use the pinned local Qwen llama-server through ngrok.
# Tunnel only the model API, never the backend. Set the key privately from llama-server.
SUMMARY_LLM_PROVIDER=local
LOCAL_MODEL_API_URL=https://YOUR_NGROK_DOMAIN.ngrok-free.app/v1
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_NAME=qwen3-4b-instruct-2507-local
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Required server-side Groq credential (LLM_API_KEY takes explicit priority).
# Keep your Groq account on Free; never enable a paid plan or automatic billing.
# Endpoint/model guards cannot prevent charges on an already upgraded account.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Exact endpoint/model allowlist is enforced; unavailable free inference fails closed.
# Apply the explicit v2 migration before serving submissions; no startup migration.
# Existing database capacity ceiling: 400,000,000 bytes (dataSize + indexSize).
